{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PerformanceTest",
  "type": "object",
  "required": ["id", "test_date", "protocol", "valid_for_profile", "source"],
  "properties": {
    "id": {"type": "string"},
    "athlete_id": {"type": ["string", "null"]},
    "test_date": {"type": "string", "format": "date"},
    "protocol": {"enum": ["two_k", "two_k_time_trial", "seven_stroke_peak", "seven_stroke_peak_power", "sixty_second", "sixty_second_maximal_effort", "twenty_second_optional", "twenty_second_maximal_effort", "thirty_min_rate_capped_optional", "thirty_min_rate_capped_maximal", "thirty_min_rate_capped_submaximal", "one_k", "one_k_time_trial", "five_k", "five_k_time_trial", "six_k", "six_k_time_trial", "on_water", "on_water_assessment", "race", "race_performance", "training_monitoring", "standardized_training_monitoring", "strength", "strength_assessment", "other", "other_custom_assessment"]},
    "protocol_version": {"type": ["string", "null"]},
    "modality": {"enum": ["ergometer", "on_water", "race_performance", "training_monitoring", "strength_assessment", "unspecified", null]},
    "testing_block_id": {"type": ["string", "null"]},
    "erg_model": {"type": ["string", "null"]},
    "drag_factor": {"type": ["number", "null"]},
    "notes": {"type": "string"},
    "valid_for_profile": {"type": "boolean"},
    "source": {"enum": ["manual", "imported", "coach_entered"]},
    "effort_intent": {"enum": ["maximal", "submaximal", "unknown", "race", null]},
    "data_quality": {"enum": ["reported", "verified", "questionable", "not_reported", "unknown", null]},
    "duration_seconds": {"type": ["integer", "null"], "minimum": 0},
    "distance_meters": {"type": ["integer", "null"], "minimum": 0},
    "time_seconds": {"type": ["number", "null"]},
    "average_watts": {"type": ["number", "null"]},
    "peak_watts": {"type": ["number", "null"]},
    "average_split_seconds": {"type": ["number", "null"], "minimum": 0},
    "average_rate_spm": {"type": ["number", "null"], "minimum": 0},
    "peak_rate_spm": {"type": ["number", "null"], "minimum": 0},
    "average_hr": {"type": ["integer", "null"], "minimum": 0},
    "peak_hr": {"type": ["integer", "null"], "minimum": 0},
    "rpe": {"type": ["integer", "null"], "minimum": 0, "maximum": 10},
    "rate_cap_spm": {"type": ["integer", "null"], "minimum": 0},
    "rate_compliance": {"type": ["string", "null"]},
    "boat_class": {"type": ["string", "null"]},
    "sculling_or_sweep": {"enum": ["sculling", "sweep", "unknown", null]},
    "crew_context": {"type": ["string", "null"]},
    "course": {"type": ["string", "null"]},
    "direction": {"type": ["string", "null"]},
    "speed_reference": {"enum": ["gps", "water_relative", "ergometer", "unspecified", null]},
    "wind": {"type": ["string", "null"]},
    "current": {"type": ["string", "null"]},
    "water_conditions": {"type": ["string", "null"]},
    "weather": {"type": ["string", "null"]},
    "rigging": {"type": ["string", "null"]},
    "interruptions": {"type": ["string", "null"]},
    "power_source": {"type": ["string", "null"]},
    "power_calibration": {"type": ["string", "null"]}
  }
}
